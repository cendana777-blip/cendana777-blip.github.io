:root{
  --bg:#050608;
  --bg-soft:#0a0d12;
  --surface:rgba(16,20,28,.78);
  --surface-2:rgba(22,27,37,.92);
  --gold:#f4c95d;
  --gold-hi:#ffe6a0;
  --gold-deep:#b88722;
  --green:#39df93;
  --text:#f8f9fb;
  --muted:#aab3c2;
  --muted-2:#737e8f;
  --line:rgba(255,255,255,.085);
  --line-gold:rgba(244,201,93,.25);
  --shadow:0 28px 90px rgba(0,0,0,.46);
  --radius:26px;
}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  min-height:100vh;
  color:var(--text);
  font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  line-height:1.6;
  padding-bottom:98px;
  background:
    radial-gradient(900px 520px at 50% -10%,rgba(244,201,93,.13),transparent 68%),
    radial-gradient(650px 450px at 100% 30%,rgba(62,104,255,.08),transparent 70%),
    radial-gradient(600px 420px at 0% 55%,rgba(244,201,93,.06),transparent 72%),
    linear-gradient(180deg,#040507 0%,#080b10 42%,#05070a 100%);
}
body::before{
  content:"";
  position:fixed;
  inset:0;
  z-index:-1;
  pointer-events:none;
  opacity:.035;
  background-image:linear-gradient(rgba(255,255,255,.5) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.5) 1px,transparent 1px);
  background-size:44px 44px;
  mask-image:linear-gradient(to bottom,#000,transparent 75%);
}
body::after{
  content:"";
  position:fixed;
  z-index:-1;
  width:420px;height:420px;
  right:-220px;top:32%;
  border-radius:50%;
  background:rgba(244,201,93,.06);
  filter:blur(80px);
  pointer-events:none;
}
img{max-width:100%;display:block}
a{text-decoration:none;color:inherit}
button{font:inherit}
.container{width:min(1180px,calc(100% - 32px));margin-inline:auto}

header{
  position:sticky;top:0;z-index:50;
  border-bottom:1px solid var(--line);
  background:rgba(4,6,9,.68);
  backdrop-filter:blur(22px) saturate(140%);
  -webkit-backdrop-filter:blur(22px) saturate(140%);
}
header::after{
  content:"";position:absolute;left:0;right:0;bottom:-1px;height:1px;
  background:linear-gradient(90deg,transparent,rgba(244,201,93,.35),transparent);
}
.nav{min-height:78px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{display:flex;align-items:center;gap:13px}
.logo{
  width:48px;height:48px;display:grid;place-items:center;overflow:hidden;
  border-radius:15px;border:1px solid var(--line-gold);
  background:linear-gradient(145deg,rgba(255,231,160,.12),rgba(255,255,255,.025));
  box-shadow:0 8px 34px rgba(244,201,93,.11),inset 0 1px rgba(255,255,255,.08);
}
.logo img{width:100%;height:100%;object-fit:contain}
.brand h1{margin:0;font-size:1.02rem;letter-spacing:.22em;font-weight:800}
.cta{
  position:relative;display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 19px;
  overflow:hidden;border:1px solid rgba(255,255,255,.12);border-radius:999px;
  color:#171108;font-weight:800;background:linear-gradient(135deg,var(--gold-hi),var(--gold));
  box-shadow:0 10px 34px rgba(244,201,93,.18),inset 0 1px rgba(255,255,255,.55);
  transition:transform .22s ease,box-shadow .22s ease,filter .22s ease;
}
.cta::before{content:"";position:absolute;inset:0;transform:translateX(-120%);background:linear-gradient(90deg,transparent,rgba(255,255,255,.35),transparent);transition:transform .5s ease}
.cta:hover{transform:translateY(-2px);filter:brightness(1.04);box-shadow:0 15px 40px rgba(244,201,93,.28)}
.cta:hover::before{transform:translateX(120%)}

.hero{padding:42px 0 26px}
.hero-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(360px,.95fr);gap:20px;align-items:stretch}
.hero-card,.hero-visual{
  position:relative;overflow:hidden;border:1px solid var(--line);border-radius:32px;
  background:linear-gradient(145deg,rgba(20,25,34,.94),rgba(8,11,16,.94));
  box-shadow:var(--shadow);isolation:isolate;
}
.hero-card{padding:clamp(28px,5vw,60px)}
.hero-card::before{
  content:"";position:absolute;width:360px;height:360px;right:-180px;top:-190px;border-radius:50%;
  background:radial-gradient(circle,rgba(244,201,93,.18),rgba(244,201,93,0) 70%);filter:blur(3px);z-index:-1;
}
.hero-card::after{
  content:"";position:absolute;left:-120px;bottom:-190px;width:340px;height:340px;border-radius:50%;
  background:radial-gradient(circle,rgba(61,112,255,.10),transparent 68%);z-index:-1;
}
.badge{
  position:relative;z-index:1;display:inline-flex;align-items:center;gap:8px;padding:8px 13px;
  border:1px solid rgba(57,223,147,.25);border-radius:999px;color:#baf4d8;background:rgba(57,223,147,.07);
  box-shadow:inset 0 1px rgba(255,255,255,.05);font-size:.78rem;font-weight:700;letter-spacing:.02em;
}
.hero-card h2{position:relative;z-index:1;margin:18px 0 14px;font-size:clamp(2.15rem,4.5vw,3.8rem);line-height:1.02;letter-spacing:-.055em}
.hero-card p{position:relative;z-index:1;max-width:650px;margin:0;color:var(--muted);font-size:1rem}
.stats{position:relative;z-index:1;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:30px}
.stat{
  position:relative;padding:16px 12px;text-align:center;overflow:hidden;border:1px solid var(--line);border-radius:19px;
  background:linear-gradient(180deg,rgba(255,255,255,.045),rgba(255,255,255,.018));
}
.stat::before{content:"";position:absolute;left:15%;right:15%;top:0;height:1px;background:linear-gradient(90deg,transparent,rgba(244,201,93,.45),transparent)}
.stat b{font-size:1.42rem;color:var(--gold-hi);text-shadow:0 0 24px rgba(244,201,93,.16)}
.stat small{color:var(--muted);font-size:.74rem}

.hero-visual{min-height:430px;background:radial-gradient(circle at 50% 35%,rgba(244,201,93,.15),transparent 36%),linear-gradient(145deg,#131a25,#070a0f)}
.hero-visual::before{content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent 20%,rgba(255,255,255,.035) 50%,transparent 80%);transform:translateX(-100%);animation:sheen 7s ease-in-out infinite}
@keyframes sheen{0%,55%{transform:translateX(-110%)}80%,100%{transform:translateX(110%)}}
.hero-visual .inner{height:100%;min-height:430px;position:relative;display:flex;flex-direction:column;justify-content:center;padding:24px}
.glow{position:absolute;top:20px;left:20px;right:20px;z-index:2;display:flex;flex-wrap:wrap;justify-content:center;gap:8px}
.pill{padding:7px 11px;border:1px solid rgba(244,201,93,.25);border-radius:999px;color:var(--gold-hi);background:rgba(7,10,14,.66);backdrop-filter:blur(12px);font-size:.66rem;font-weight:800;letter-spacing:.07em;box-shadow:inset 0 1px rgba(255,255,255,.05)}
.hero-image{width:min(100%,470px);margin:54px auto 0;border-radius:24px;overflow:hidden;border:1px solid rgba(255,255,255,.13);background:#07090d;box-shadow:0 34px 80px rgba(0,0,0,.55),0 0 0 8px rgba(255,255,255,.018);transform:translateY(0);transition:transform .35s ease,box-shadow .35s ease}
.hero-image:hover{transform:translateY(-6px) scale(1.008);box-shadow:0 42px 100px rgba(0,0,0,.66),0 0 0 8px rgba(244,201,93,.035)}
.hero-image img{width:100%;aspect-ratio:16/10;object-fit:cover}

.safe{margin:0 0 32px;padding:13px 18px;text-align:center;color:#dbe1ea;border:1px solid rgba(244,201,93,.14);border-radius:16px;background:linear-gradient(90deg,rgba(244,201,93,.055),rgba(255,255,255,.025),rgba(244,201,93,.055));font-size:.8rem;box-shadow:inset 0 1px rgba(255,255,255,.035)}
#bukti{scroll-margin-top:100px}
.section-title{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin:0 0 18px}
.section-title h3{margin:0;font-size:clamp(1.4rem,3vw,2.05rem);letter-spacing:-.035em}
.filter{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}
.filter button{cursor:pointer;border:1px solid var(--line);color:#b9c2cf;background:rgba(255,255,255,.032);border-radius:999px;padding:9px 14px;font-weight:700;font-size:.77rem;transition:all .22s ease;box-shadow:inset 0 1px rgba(255,255,255,.025)}
.filter button:hover{color:#fff;border-color:rgba(244,201,93,.22);background:rgba(244,201,93,.06);transform:translateY(-1px)}
.filter button.active{color:#171108;border-color:transparent;background:linear-gradient(135deg,var(--gold-hi),var(--gold));box-shadow:0 10px 28px rgba(244,201,93,.18),inset 0 1px rgba(255,255,255,.5)}

.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.card{position:relative;overflow:hidden;border:1px solid var(--line);border-radius:23px;background:linear-gradient(180deg,#121822,#090d13);box-shadow:0 16px 48px rgba(0,0,0,.27);transition:transform .28s ease,border-color .28s ease,box-shadow .28s ease}
.card::before{content:"";position:absolute;inset:0;z-index:2;pointer-events:none;border-radius:inherit;background:linear-gradient(135deg,rgba(255,255,255,.07),transparent 32%,transparent 72%,rgba(244,201,93,.04))}
.card:hover{transform:translateY(-7px);border-color:rgba(244,201,93,.3);box-shadow:0 28px 65px rgba(0,0,0,.43)}
.card>img{width:100%;aspect-ratio:4/3;object-fit:cover;background:#07090d;transition:transform .5s cubic-bezier(.2,.7,.2,1),filter .35s ease}
.card:hover>img{transform:scale(1.045);filter:saturate(1.08)}
.meta{padding:16px 17px 18px}.amount{color:var(--gold-hi);font-size:1.08rem;font-weight:800}.proof{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:9px}.proof small{color:var(--muted-2);font-size:.71rem}.tag{display:inline-flex;padding:5px 8px;border-radius:999px;color:#baf4d8;background:rgba(57,223,147,.08);border:1px solid rgba(57,223,147,.18);font-size:.64rem;font-weight:800}

.fixed-cta{position:fixed;z-index:60;left:0;right:0;bottom:0;padding:10px 0 calc(10px + env(safe-area-inset-bottom));border-top:1px solid var(--line);background:rgba(4,6,9,.76);backdrop-filter:blur(22px) saturate(140%);-webkit-backdrop-filter:blur(22px) saturate(140%);box-shadow:0 -18px 55px rgba(0,0,0,.28)}
.fixed-cta .wrap{display:grid;grid-template-columns:1fr 1fr;gap:10px}.btn{min-height:47px;display:flex;align-items:center;justify-content:center;padding:0 16px;border-radius:15px;font-weight:800;font-size:.83rem;border:1px solid rgba(255,255,255,.08);transition:transform .2s ease,filter .2s ease,box-shadow .2s ease}.btn:hover{transform:translateY(-2px);filter:brightness(1.06)}
.btn.wa{color:#06150e;background:linear-gradient(135deg,#6bf0ac,#25c77a);box-shadow:0 10px 28px rgba(37,199,122,.13)}.btn.tg{color:#171108;background:linear-gradient(135deg,var(--gold-hi),var(--gold));box-shadow:0 10px 28px rgba(244,201,93,.15)}

.overlay{position:fixed;inset:0;z-index:80;background:rgba(0,0,0,.72);backdrop-filter:blur(7px);-webkit-backdrop-filter:blur(7px)}
.popup{position:fixed;z-index:90;left:50%;top:50%;width:min(440px,calc(100% - 28px));padding:24px;transform:translate(-50%,-50%);border:1px solid rgba(244,201,93,.24);border-radius:25px;background:linear-gradient(145deg,#171e29,#090d13);box-shadow:0 34px 110px rgba(0,0,0,.7),inset 0 1px rgba(255,255,255,.06)}
.popup::before{content:"";position:absolute;left:18%;right:18%;top:0;height:1px;background:linear-gradient(90deg,transparent,rgba(244,201,93,.7),transparent)}
.popup-header{display:flex;align-items:center;justify-content:space-between;gap:14px}.popup h4{margin:0;font-size:1.16rem}.popup p{color:var(--muted);margin:15px 0 20px}.popup .row{display:grid;grid-template-columns:1fr 1fr;gap:9px}.close{width:36px;height:36px;display:grid;place-items:center;cursor:pointer;border:1px solid var(--line);border-radius:50%;color:#d8dee8;background:rgba(255,255,255,.04);transition:background .2s ease,transform .2s ease}.close:hover{background:rgba(255,255,255,.08);transform:rotate(4deg)}
footer{padding:34px 0 115px;color:#778292;text-align:center;font-size:.75rem}

@media (max-width:900px){.hero-grid{grid-template-columns:1fr}.hero-visual,.hero-visual .inner{min-height:360px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:620px){
  .container{width:min(100% - 20px,1180px)}.nav{min-height:68px}.brand h1{font-size:.86rem;letter-spacing:.17em}.logo{width:40px;height:40px;border-radius:12px}.cta{min-height:40px;padding:0 13px;font-size:.74rem}.hero{padding-top:22px}.hero-card{padding:25px 20px}.hero-card h2{font-size:2rem}.stats{gap:7px}.stat{padding:13px 7px}.stat b{font-size:1.05rem}.stat small{font-size:.67rem}.hero-visual,.hero-visual .inner{min-height:300px}.hero-visual .inner{padding:16px}.glow{top:15px;left:12px;right:12px}.hero-image{margin-top:45px}.section-title{align-items:flex-start;flex-direction:column}.filter{justify-content:flex-start}.grid{grid-template-columns:1fr;gap:14px}.fixed-cta .wrap{width:calc(100% - 20px)}.btn{font-size:.74rem;padding:0 10px}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important;animation:none!important}}
